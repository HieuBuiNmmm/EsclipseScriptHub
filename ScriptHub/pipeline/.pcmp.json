{
    "openComposedOutput": true,

    "deployment": {
        "enabled": true,
        "cloudflare": {
            "enabled": true,
            "apiUrl": "https://esclipse-keysystem.bhieu4225.workers.dev/api/admin/upload-script",
            "adminSecret": "EsclipseSecret2026"
        },
        "github": {
            "enabled": false,
            "apiKey": "API_KEY_HERE",
            "owner": "REPOSITORY_OWNER_HERE",
            "repo": "REPOSITORY_NAME_HERE"
        }
    },

    "buildConfigs": [
        {
            "name": "Debug",

            "promptVersion": false,
            "promptDeploy": false,

            "frame": "pipeline/frame.luau",
            "darkluaConfig": "pipeline/.darklua_debug.json",
            "input": "src/main.luau",
            "output": "generated/debug.luau"
        },

        {
            "name": "Beta",

            "promptVersion": true,
            "promptDeploy": true,
            "prerelease": true,

            "frame": "pipeline/frame.luau",
            "darkluaConfig": "pipeline/.darklua.json",
            "input": "src/main.luau",
            "output": "generated/beta.luau"
        },

        {
            "name": "Release",
            
            "promptVersion": true,
            "promptDeploy": true,

            "frame": "pipeline/frame.luau",
            "darkluaConfig": "pipeline/.darklua.json",
            "input": "src/main.luau",
            "output": "generated/release.luau"
        },

        {
            "name": "Loader",
            
            "promptVersion": false,
            "promptDeploy": false,

            "frame": "pipeline/frame.luau",
            "darkluaConfig": "pipeline/.darklua.json",
            "input": "src/loader.luau",
            "output": "generated/loader.luau"
        }
    ]
}