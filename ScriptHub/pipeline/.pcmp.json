{
    "openComposedOutput": true,

    "deployment": {
        "enabled": true,
        "github": {
            "enabled": false,
            "apiKey": "API_KEY_HERE",
            "owner": "REPOSITORY_OWNER_HERE",
            "repo": "REPOSITORY_NAME_HERE"
        }
    },

    "buildConfigs": [
        {
            "name": "Full_Debug",

            "promptVersion": false,
            "promptDeploy": false,

            "frame": "pipeline/frame.luau",
            "darkluaConfig": "pipeline/.darklua_debug.json",
            "input": "src/main.luau",
            "output": "generated/debug.luau"
        },

        {
            "name": "Full_Release",
            
            "promptVersion": false,
            "promptDeploy": false,

            "frame": "pipeline/frame.luau",
            "darkluaConfig": "pipeline/.darklua.json",
            "input": "src/main.luau",
            "output": "generated/release.luau"
        },

        {
            "name": "Recorder_Debug",

            "promptVersion": false,
            "promptDeploy": false,

            "frame": "pipeline/frame.luau",
            "darkluaConfig": "pipeline/.darklua_debug.json",
            "input": "src/recorder_main.luau",
            "output": "generated/recorder_debug.luau"
        },

        {
            "name": "Recorder_Release",

            "promptVersion": false,
            "promptDeploy": false,

            "frame": "pipeline/frame.luau",
            "darkluaConfig": "pipeline/.darklua.json",
            "input": "src/recorder_main.luau",
            "output": "generated/recorder_release.luau"
        }
    ]
}