			local flatTarget = Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)
			humanoid:MoveTo(flatTarget)
			task.wait(0.05)
		end

		-- (3) Hết ngân sách thời gian mà vẫn chưa đứng đúng chỗ: snap nốt phần còn lại
